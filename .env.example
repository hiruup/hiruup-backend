# WAQI API Token (obtain free from https://aqicn.org/data-platform/token/)
WAQI_TOKEN=your_waqi_api_token_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Geocoder Nominatim custom User-Agent
NOMINATIM_USER_AGENT=Hiruup/1.0 (contact: info@example.com)

# In-memory cache TTL in milliseconds (default: 15 minutes = 900000)
CACHE_TTL_MS=900000
